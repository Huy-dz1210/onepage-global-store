DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintrack?schema=public"
# Base URL của chính app (sync engine gọi mock API qua HTTP)
APP_URL="http://127.0.0.1:3000"
# Chu kỳ đồng bộ tự động (phút). Đặt 1 để demo "gần realtime".
SYNC_INTERVAL_MINUTES=30
# Bật/tắt scheduler chạy trong process Next.js
SYNC_SCHEDULER_ENABLED=true
# Khóa mã hóa credentials (32 bytes hex). Tạo: openssl rand -hex 32
ENCRYPTION_KEY="5b2c1f0e8d7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c"

# Secret ký webhook giữa provider (mock) và app
WEBHOOK_SECRET="dev-webhook-secret"
# Tỷ lệ lỗi giả lập của mock API (0 – 1) để test retry
MOCK_FAILURE_RATE=0
